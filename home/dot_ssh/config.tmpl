HashKnownHosts no

{{ if eq .hostname "macbook-air-m3" -}}
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

{{ end -}}

Host cachyos
  HostName cachyos
  ForwardAgent yes

Host github.com
  User git

Host macbook-air-m3
  User twp

Host pi-hole
  SetEnv TERM=xterm-256color # https://github.com/pi-hole/pi-hole/issues/6048

Host proxmox
  HostName proxmox
  User root

Host ubuntu-26
  ForwardAgent yes
  HostName ubuntu-26

Host windows
  HostName windows
  User twpay
